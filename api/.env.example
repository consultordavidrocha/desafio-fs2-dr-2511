# Conexão com o Postgres (docker compose expõe na porta 5434 do host)
DATABASE_URL=postgresql://juscash:juscash@localhost:5434/juscash?schema=public

# Segredo do JWT: mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1d

# Origens liberadas no CORS, separadas por vírgula (vazio = qualquer origem)
CORS_ORIGIN=http://localhost:3099

PORT=8888
