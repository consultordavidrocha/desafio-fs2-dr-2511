# Ambiente dos testes e2e (versionado de propósito: não contém segredos reais).
# Conexão com o Postgres (docker compose expõe na porta 5434 do host)
DATABASE_URL=postgresql://juscash:juscash@localhost:5434/juscash_test?schema=public

# Segredo do JWT: mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=segredo-exclusivo-dos-testes-e2e-nao-usar-em-producao
JWT_EXPIRES_IN=1d

# Origens liberadas no CORS, separadas por vírgula (vazio = qualquer origem)
CORS_ORIGIN=

PORT=8888

# Alto nos testes: a suíte faz muitos logins seguidos (o 429 tem teste próprio)
AUTH_RATE_LIMIT=1000
