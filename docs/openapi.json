{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Verifica se a API e o banco estão no ar",
        "tags": [
          "Saúde"
        ]
      }
    },
    "/live": {
      "get": {
        "operationId": "LiveController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Verifica se a API está no ar (sem consultar o banco)",
        "tags": [
          "Saúde"
        ]
      }
    },
    "/auth/cadastro": {
      "post": {
        "operationId": "AuthController_signUp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "409": {
            "description": "E-mail já cadastrado"
          },
          "429": {
            "description": "Muitas tentativas por minuto"
          }
        },
        "summary": "Cria uma conta",
        "tags": [
          "Autenticação"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "E-mail ou senha incorretos"
          },
          "429": {
            "description": "Muitas tentativas por minuto"
          }
        },
        "summary": "Autentica e devolve o access token (JWT)",
        "tags": [
          "Autenticação"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Sem token ou token inválido"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Usuário autenticado",
        "tags": [
          "Autenticação"
        ]
      }
    },
    "/tribunais": {
      "get": {
        "operationId": "CourtsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CourtDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sem token ou token inválido"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Lista os tribunais (para o filtro)",
        "tags": [
          "Tribunais"
        ]
      }
    },
    "/comunicacoes": {
      "get": {
        "operationId": "CommunicationsController_list",
        "parameters": [
          {
            "name": "numeroProcesso",
            "required": false,
            "in": "query",
            "description": "Número CNJ, com ou sem máscara",
            "schema": {
              "example": "1234567-89.2024.8.26.0100",
              "type": "string"
            }
          },
          {
            "name": "tribunal",
            "required": false,
            "in": "query",
            "description": "Sigla do tribunal",
            "schema": {
              "example": "TJSP",
              "type": "string"
            }
          },
          {
            "name": "dataInicio",
            "required": false,
            "in": "query",
            "description": "Data inicial (inclusiva), YYYY-MM-DD",
            "schema": {
              "example": "2025-08-01",
              "type": "string"
            }
          },
          {
            "name": "dataFim",
            "required": false,
            "in": "query",
            "description": "Data final (inclusiva), YYYY-MM-DD",
            "schema": {
              "example": "2025-08-31",
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 10000,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunicationPageDto"
                }
              }
            }
          },
          "400": {
            "description": "Filtro inválido (ex.: pageSize acima de 50, data inválida)"
          },
          "401": {
            "description": "Sem token ou token inválido"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Lista paginada de comunicações, da mais recente para a mais antiga",
        "tags": [
          "Comunicações"
        ]
      }
    },
    "/comunicacoes/{id}/resumo": {
      "post": {
        "operationId": "CommunicationsController_summarize",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunicationSummaryDto"
                }
              }
            }
          },
          "400": {
            "description": "id inválido"
          },
          "401": {
            "description": "Sem token ou token inválido"
          },
          "404": {
            "description": "Comunicação não encontrada"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Resumo do conteúdo da comunicação (bônus)",
        "tags": [
          "Comunicações"
        ]
      }
    },
    "/processos/{numero}": {
      "get": {
        "operationId": "LawsuitsController_findOne",
        "parameters": [
          {
            "name": "numero",
            "required": true,
            "in": "path",
            "description": "Número CNJ, com ou sem máscara",
            "schema": {
              "example": "1234567-89.2024.8.26.0100",
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 10000,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LawsuitDetailDto"
                }
              }
            }
          },
          "400": {
            "description": "Número ou paginação inválidos"
          },
          "401": {
            "description": "Sem token ou token inválido"
          },
          "404": {
            "description": "Processo não encontrado"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Detalhe do processo e suas comunicações (bônus)",
        "tags": [
          "Processos"
        ]
      }
    }
  },
  "info": {
    "title": "JusCash Comunicações — API",
    "description": "Consulta de comunicações processuais publicadas no DJEN. Rotas protegidas exigem `Authorization: Bearer <accessToken>` (obtido em POST /auth/login).",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SignUpDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Amélia Mascarenhas Macedo",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "example": "amelia@exemplo.com"
          },
          "password": {
            "type": "string",
            "example": "senhaSegura123",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Amélia Mascarenhas Macedo"
          },
          "email": {
            "type": "string",
            "example": "amelia@exemplo.com"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "amelia@exemplo.com"
          },
          "password": {
            "type": "string",
            "example": "senhaSegura123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "CourtDto": {
        "type": "object",
        "properties": {
          "acronym": {
            "type": "string",
            "example": "TJSP",
            "description": "Sigla do tribunal"
          },
          "name": {
            "type": "string",
            "example": "Tribunal de Justiça de São Paulo"
          }
        },
        "required": [
          "acronym",
          "name"
        ]
      },
      "RecipientDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Amélia Mascarenhas Macedo"
          },
          "side": {
            "type": "object",
            "example": "A",
            "nullable": true,
            "description": "Polo processual"
          }
        },
        "required": [
          "name"
        ]
      },
      "CommunicationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 123456
          },
          "lawsuitNumber": {
            "type": "string",
            "example": "1234567-89.2024.8.26.0100",
            "description": "Número CNJ com máscara"
          },
          "lawsuitClass": {
            "type": "object",
            "example": "Procedimento comum",
            "nullable": true
          },
          "court": {
            "type": "string",
            "example": "TJSP",
            "description": "Sigla do tribunal"
          },
          "availabilityDate": {
            "type": "string",
            "example": "2025-08-15",
            "description": "Data de disponibilização (YYYY-MM-DD)"
          },
          "type": {
            "type": "string",
            "example": "Intimação"
          },
          "documentType": {
            "type": "object",
            "example": "Despacho",
            "nullable": true
          },
          "courtUnit": {
            "type": "object",
            "example": "1ª Vara Cível de Campinas",
            "nullable": true
          },
          "content": {
            "type": "string",
            "description": "Texto integral da comunicação"
          },
          "link": {
            "type": "object",
            "nullable": true,
            "description": "Link para o documento"
          },
          "recipients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipientDto"
            }
          }
        },
        "required": [
          "id",
          "lawsuitNumber",
          "court",
          "availabilityDate",
          "type",
          "content",
          "recipients"
        ]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 1
          },
          "pageSize": {
            "type": "number",
            "example": 10
          },
          "total": {
            "type": "number",
            "example": 42,
            "description": "Total de itens com os filtros"
          },
          "totalPages": {
            "type": "number",
            "example": 5
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages"
        ]
      },
      "CommunicationPageDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommunicationDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "CommunicationSummaryDto": {
        "type": "object",
        "properties": {
          "highlights": {
            "example": [
              "Prazo: 15 dias"
            ],
            "description": "Destaques objetivos encontrados no texto",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string",
            "description": "Frases mais relevantes da comunicação (resumo extrativo)"
          }
        },
        "required": [
          "highlights",
          "summary"
        ]
      },
      "LawsuitDto": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "example": "1234567-89.2024.8.26.0100"
          },
          "className": {
            "type": "object",
            "example": "Procedimento comum",
            "nullable": true
          },
          "court": {
            "type": "string",
            "example": "TJSP"
          },
          "recipients": {
            "example": [
              "Amélia Mascarenhas Macedo",
              "Paula Silva Santos"
            ],
            "description": "Destinatários de todas as comunicações, sem repetição",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "totalCommunications": {
            "type": "number",
            "example": 3,
            "description": "Quantidade de comunicações (atualizações)"
          },
          "finalJudgment": {
            "type": "boolean",
            "description": "Alguma comunicação do processo menciona trânsito em julgado"
          }
        },
        "required": [
          "number",
          "court",
          "recipients",
          "totalCommunications",
          "finalJudgment"
        ]
      },
      "LawsuitCommunicationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 123456
          },
          "lawsuitNumber": {
            "type": "string",
            "example": "1234567-89.2024.8.26.0100",
            "description": "Número CNJ com máscara"
          },
          "lawsuitClass": {
            "type": "object",
            "example": "Procedimento comum",
            "nullable": true
          },
          "court": {
            "type": "string",
            "example": "TJSP",
            "description": "Sigla do tribunal"
          },
          "availabilityDate": {
            "type": "string",
            "example": "2025-08-15",
            "description": "Data de disponibilização (YYYY-MM-DD)"
          },
          "type": {
            "type": "string",
            "example": "Intimação"
          },
          "documentType": {
            "type": "object",
            "example": "Despacho",
            "nullable": true
          },
          "courtUnit": {
            "type": "object",
            "example": "1ª Vara Cível de Campinas",
            "nullable": true
          },
          "content": {
            "type": "string",
            "description": "Texto integral da comunicação"
          },
          "link": {
            "type": "object",
            "nullable": true,
            "description": "Link para o documento"
          },
          "recipients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipientDto"
            }
          },
          "mentionsFinalJudgment": {
            "type": "boolean",
            "description": "O texto menciona trânsito em julgado",
            "example": false
          }
        },
        "required": [
          "id",
          "lawsuitNumber",
          "court",
          "availabilityDate",
          "type",
          "content",
          "recipients",
          "mentionsFinalJudgment"
        ]
      },
      "LawsuitDetailDto": {
        "type": "object",
        "properties": {
          "lawsuit": {
            "$ref": "#/components/schemas/LawsuitDto"
          },
          "communications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LawsuitCommunicationDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "lawsuit",
          "communications",
          "meta"
        ]
      }
    }
  }
}
