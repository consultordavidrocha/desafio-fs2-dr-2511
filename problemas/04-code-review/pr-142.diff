@@ -0,0 +1,43 @@
+import { Injectable } from '@nestjs/common';
+import { PrismaService } from '../prisma/prisma.service';
+
+@Injectable()
+export class ClientesComunicacoesService {
+  constructor(private readonly prisma: PrismaService) {}
+
+  async buscarPorCpf(cpf: any) {
+    try {
+      const comunicacoes: any[] = await this.prisma.$queryRawUnsafe(
+        `SELECT c.* FROM comunicacao c
+           JOIN destinatario d ON d.comunicacao_id = c.id
+          WHERE d.cpf = '${cpf}'
+          ORDER BY c.data_disponibilizacao DESC`,
+      );
+
+      for (const comunicacao of comunicacoes) {
+        comunicacao.destinatarios = await this.prisma.destinatario.findMany({
+          where: { comunicacaoId: comunicacao.id },
+        });
+      }
+
+      return comunicacoes;
+    } catch (e) {
+      return [];
+    }
+  }
+
+  async listarPorPeriodo(cpf: any, dataInicio: string, dataFim: string) {
+    return this.prisma.comunicacao.findMany({
+      where: {
+        destinatarios: { some: { cpf } },
+        dataDisponibilizacao: {
+          gte: new Date(dataInicio),
+          lte: new Date(dataFim),
+        },
+      },
+      include: { destinatarios: true },
+      orderBy: { dataDisponibilizacao: 'desc' },
+      take: 100,
+    });
+  }
+}
