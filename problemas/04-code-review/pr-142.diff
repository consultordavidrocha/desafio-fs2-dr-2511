+import { Controller, Get, Logger, Query, Req } from '@nestjs/common';
+import { ApiTags } from '@nestjs/swagger';
+import { Request } from 'express';
+import { ClientesComunicacoesService } from './clientes-comunicacoes.service';
+
+@ApiTags('clientes')
+@Controller('clientes')
+export class ClientesComunicacoesController {
+  private readonly logger = new Logger(ClientesComunicacoesController.name);
+
+  constructor(private readonly service: ClientesComunicacoesService) {}
+
+  // Busca as comunicações em que o cliente (CPF) aparece como destinatário
+  @Get('comunicacoes')
+  async buscarPorCpf(@Query('cpf') cpf: any, @Req() req: Request) {
+    this.logger.log(`Busca por CPF ${cpf} - headers: ${JSON.stringify(req.headers)}`);
+    return this.service.buscarPorCpf(cpf);
+  }
+
+  // Comunicações do cliente no período (usado no relatório mensal)
+  @Get('comunicacoes/periodo')
+  async listarPorPeriodo(
+    @Query('cpf') cpf: any,
+    @Query('dataInicio') dataInicio: string,
+    @Query('dataFim') dataFim: string,
+  ) {
+    return this.service.listarPorPeriodo(cpf, dataInicio, dataFim);
+  }
+}
